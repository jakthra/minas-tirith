# Minas Tirith — local development configuration.
#
# Copy this file to .env (gitignored) and fill in your local values:
#
#     cp .env.example .env
#
# Both binaries (cmd/listener, cmd/worker) load .env from the working
# directory at startup, before resolving flags and defaults, so local
# values live in one file instead of every shell session. The values
# below are the built-in defaults: keep a line to stay on the default,
# change it to override, comment it out to fall back entirely.
#
# Precedence: command-line flags > variables exported in the shell >
# values in this file > defaults. The file fills gaps — it never
# overrides a variable the shell has already set. A missing .env file
# is fine: defaults, environment variables, and flags work as before.
#
# Parsing: one KEY=VALUE per line; blank lines and # comments are
# skipped; keys may carry an `export ` prefix; values may be single- or
# double-quoted (a quoted value must end the line); unquoted values may
# carry a trailing # comment. Relative paths resolve against the
# working directory (src/ when run from there).

# --- Listener (cmd/listener) ---------------------------------------------

# Address the webhook endpoint listens on.
LISTEN_ADDR=:9797

# Path to the declarative watched-repositories config file, one repo
# with its webhook secret per entry (see src/watched.yaml). When unset
# or empty, watched.yaml in the working directory is the fallback.
WATCHED_CONFIG=watched.yaml

# How long event identities are remembered so duplicate deliveries
# are not dispatched twice.
DEDUPE_TTL=24h

# --- Worker (cmd/worker) -------------------------------------------------

# Forgejo/Gitea instance the agent activities access repositories on
# (the dev instance: just forgejo-up).
FORGEJO_URL=http://localhost:3000

# Forgejo access token for agent repository access. The worker requires
# it to start. No default: create one in the dev instance
# (Settings → Applications).
FORGEJO_TOKEN=

# OpenAI-compatible LLM API the agent activities reason through. Any
# OpenAI-compatible endpoint works: Mistral (the default), OpenAI,
# Ollama, vLLM, LM Studio, OpenRouter, ...
LLM_BASE_URL=https://api.mistral.ai/v1

# LLM provider API key for agent reasoning (Authorization: Bearer).
# The worker requires it to start. No default: with the default base
# URL this is a Mistral API key.
LLM_API_KEY=

# Model requested for agent reasoning.
LLM_MODEL=mistral-small-latest

# --- Shared (cmd/listener + cmd/worker) ----------------------------------

# Temporal frontend gRPC address (the dev server: just temporal-dev).
TEMPORAL_HOST_PORT=localhost:7233

# Temporal namespace workflows run in.
TEMPORAL_NAMESPACE=default

# Base task queue; each agent template polls its own <queue>-<template>.
TEMPORAL_TASK_QUEUE=minas-tirith
